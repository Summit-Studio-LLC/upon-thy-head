<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app's goes to Google Drive (docs/android-plan.md 8.2). allowBackup="false"
     already says so; these rules say it again for phones that read them. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
